{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "outDir": "./.tsbuild/api"
  },
  "include": [
    "api"
  ]
}