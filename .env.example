VITE_MAPBOX_TOKEN=your_public_mapbox_token
SLACK_WEBHOOK_URL=your_server_side_slack_incoming_webhook

# Optional. Without these the app runs on its deterministic assembler and the
# cross-model entailment gate reports 'skipped'. Gates 1-3 always run.
GEMINI_API_KEY=your_google_ai_studio_key
GROQ_API_KEY=your_groq_key
